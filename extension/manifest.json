{
  "manifest_version": 3,
  "name": "四片 · X 图片切分",
  "version": "1.1.0",
  "description": "拖入横图，按从左到右四等分，预览后加入 X 发帖附件。",
  "permissions": ["clipboardRead"],
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://www.twitter.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
